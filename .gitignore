# Entornos virtuales de Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / cachés
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Archivos de datos pesados generales
*.tar.gz
*.rar
*.csv
*.zip

# --- CONFIGURACIÓN DE DATASETS ---
# 1. Dataset Malicious Phish (USO PRIVADO LOCAL - Totalmente ignorado)
data/malicious_phish/*
!data/malicious_phish/.gitkeep

# 2. Dataset PhiUSIIL (COMPARTIDO CON EL EQUIPO)
data/phiusiil/raw/*
!data/phiusiil/raw/.gitkeep
!data/phiusiil/raw/PhiUSIIL_Phishing_URL_Dataset.zip
data/phiusiil/processed/*
!data/phiusiil/processed/.gitkeep
data/phiusiil/samples/*
!data/phiusiil/samples/.gitkeep

# Excepción para el zip comprimido de PhiUSIIL
!data/phiusiil/raw/PhiUSIIL_Phishing_URL_Dataset.zip

# Modelos pesados guardados (usar Git LFS o regenerar localmente)
saved_models/*
!saved_models/.gitkeep
*.h5
*.keras
*.pkl
*.joblib

# Logs y métricas temporales
logs/
*.log

# Informes y documentación (se redactan externamente en Google Docs)
docs/

# IDEs y editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
